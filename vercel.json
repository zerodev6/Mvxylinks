{
  "builds": [
    { "src": "api/st.py", "use": "@vercel/python" },
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/api/st", "destination": "/api/st" },
    { "source": "/api/index", "destination": "/api/index" },
    { "source": "/:code", "destination": "/api/index?code=:code" }
  ]
}
